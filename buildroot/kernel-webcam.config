# Linux kernel options needed for a USB (UVC) webcam on the DE10-Standard.
# Add them with `make ARCH=arm menuconfig` in the kernel tree (or append to
# .config and run `make ARCH=arm olddefconfig`), then rebuild zImage.
CONFIG_USB=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_HOST=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_V4L2=y
CONFIG_USB_VIDEO_CLASS=y
CONFIG_USB_VIDEO_CLASS_INPUT_EVDEV=y
# ADXL345 is read from userspace through /dev/i2c-0
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
